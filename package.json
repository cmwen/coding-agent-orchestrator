{
  "name": "coding-agent-orchestrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm build:packages && pnpm -r build",
    "build:packages": "pnpm --filter @coding-agent-orchestrator/shared build && pnpm --filter @coding-agent-orchestrator/store build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "dev": "pnpm build:packages && concurrently -k -n runtime,web \"pnpm dev:runtime\" \"pnpm dev:web\"",
    "dev:runtime": "pnpm --filter @coding-agent-orchestrator/runtime dev",
    "dev:web": "pnpm --filter @coding-agent-orchestrator/web dev",
    "wait:runtime": "node ./scripts/wait-for-runtime.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "latest",
    "concurrently": "latest",
    "jsdom": "^29.1.1",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
